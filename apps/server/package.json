{
  "name": "@idle/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --outDir dist --noEmit false",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@idle/api-contract": "workspace:*",
    "@idle/game-core": "workspace:*",
    "fastify": "^5.0.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/pg": "^8.23.1"
  }
}

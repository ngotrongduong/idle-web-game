# Local defaults. For staging/production, use a strong URL-safe database password.
POSTGRES_DB=guildhall
POSTGRES_USER=guildhall
POSTGRES_PASSWORD=change-this-password

# Local: serve on host port 8080.
# Staging/production: set SITE_ADDRESS to a real DNS name and HTTP/HTTPS ports to 80/443.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
